#!/usr/bin/env node
import { existsSync, readFileSync } from "node:fs";
import path from "node:path";
import { spawnSync } from "node:child_process";
import { parseArgs } from "node:util";
import { fileURLToPath } from "node:url";
import { parseDocument } from "./vendor/yaml.mjs";
import { resolveContextTermRefs, verifyContextSnapshot } from "./lib/context-contract.mjs";

const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const schemaPath = path.join(repoRoot, "docs/process/schemas/strategic-design-handoff.schema.json");
const pythonValidator = String.raw`
import json, sys
from jsonschema import Draft202012Validator
schema = json.load(open(sys.argv[1], encoding="utf-8"))
value = json.load(sys.stdin)
errors = sorted(Draft202012Validator(schema).iter_errors(value), key=lambda error: list(error.absolute_path))
for error in errors:
    where = ".".join(str(part) for part in error.absolute_path) or "<root>"
    print(f"{where}: {error.message}", file=sys.stderr)
sys.exit(1 if errors else 0)
`;

function parseFile(file) {
  const document = parseDocument(readFileSync(file, "utf8"), { maxAliasCount: 0, uniqueKeys: true });
  if (document.errors.length) throw new TypeError(document.errors[0].message);
  return document.toJS({ maxAliasCount: 0 });
}

try {
  const { values, positionals } = parseArgs({ options: { root: { type: "string", default: process.cwd() } }, allowPositionals: true, strict: true });
  if (positionals.length !== 1) throw new TypeError("用法: scripts/verify-strategic-design-handoff [--root <repo>] <handoff.yaml|json>");
  const root = path.resolve(values.root);
  const value = parseFile(path.resolve(positionals[0]));
  if (value.schema_version === 1) {
    const error = new TypeError("migration-required: Strategic Design Handoff v1 缺少结构化 source_context_snapshot/context_delta，必须人工补齐后升级 v2");
    error.code = "migration-required";
    throw error;
  }
  const schemaResult = spawnSync("python3", ["-c", pythonValidator, schemaPath], { encoding: "utf8", input: JSON.stringify(value) });
  if (schemaResult.status !== 0) throw new TypeError(`${schemaResult.stdout}${schemaResult.stderr}`.trim());
  const contract = verifyContextSnapshot(value.source_context_snapshot, { root });
  const deltaTerms = [...value.context_delta.added, ...value.context_delta.updated, ...value.context_delta.deprecated];
  const deltaRefs = deltaTerms.map((term) => term.term_ref);
  const resolvedDelta = resolveContextTermRefs(contract, deltaRefs).terms;
  if (new Set(deltaRefs).size !== deltaRefs.length) throw new TypeError("context_delta 中的术语引用不得跨分类重复");
  for (let index = 0; index < deltaTerms.length; index += 1) {
    const expected = resolvedDelta[index];
    const actual = deltaTerms[index];
    for (const field of ["term", "meaning", "english_identifier", "context_id"]) if (actual[field] !== expected[field]) throw new TypeError(`context_delta.${actual.term_ref}.${field} 与源 CONTEXT.md 不一致`);
    if (JSON.stringify([...actual.forbidden_aliases].sort()) !== JSON.stringify([...expected.forbidden_aliases].sort())) throw new TypeError(`context_delta.${actual.term_ref}.forbidden_aliases 与源 CONTEXT.md 不一致`);
  }
  const snapshotRefs = new Set(value.source_context_snapshot.term_refs);
  for (const ref of deltaRefs) if (!snapshotRefs.has(ref)) throw new TypeError(`context_delta 术语必须包含在 source_context_snapshot.term_refs: ${ref}`);
  for (const ref of Object.values(value.source)) {
    const persisted = path.resolve(root, ref.persisted_ref);
    if (!persisted.startsWith(`${root}${path.sep}`) || !existsSync(persisted)) throw new TypeError(`source persisted_ref 不可读或越界: ${ref.persisted_ref}`);
  }
  for (const ref of value.evidence_and_version_digests) {
    const evidence = path.resolve(root, ref);
    if (!evidence.startsWith(`${root}${path.sep}`) || !existsSync(evidence)) throw new TypeError(`交接证据不可读或越界: ${ref}`);
  }
  process.stdout.write("Strategic Design Handoff v2 验证通过\n");
} catch (error) {
  process.stderr.write(`Strategic Design Handoff 验证失败: ${error.message}\n`);
  process.exitCode = 1;
}
